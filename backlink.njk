{#- Only on notes that might be about a hex: named with the prefix, or with hex: in frontmatter -#}
{%- set hxSlug = (page.fileSlug or "") | lower -%}
{%- set hxPre = (pluginSettings.notePrefix or "Hex") | lower -%}
{%- if (noteProps and noteProps.hex) or hxSlug.indexOf(hxPre) == 0 -%}
<div class="hexcrawl-backlinks" hidden></div>
<script>
  (function () {
    var box = document.currentScript.previousElementSibling;
    var here = decodeURI(location.pathname).replace(/\/?$/, "/");
    fetch("/hexcrawl-map.json")
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (index) {
        if (!index || !index.maps || !index.maps.length) return;
        var base = index.maps[0].url;
        Object.keys(index.hexes || {}).forEach(function (n) {
          var mine = index.hexes[n].some(function (note) {
            return decodeURI(note.url).replace(/\/?$/, "/") === here;
          });
          if (!mine) return;
          var a = document.createElement("a");
          a.className = "hexcrawl-backlink";
          a.href = base + "?hex=" + n;
          a.textContent = "Hex " + n + " on the map";
          box.appendChild(a);
        });
        if (box.children.length) box.hidden = false;
      })
      .catch(function () {});
  })();
</script>
{%- endif -%}
